. *-------------------------------------------------------------------------------
. * Cleaning NTL
. *-------------------------------------------------------------------------------
. import excel "$data/ntl_monthly_long.xlsx", sheet("Sheet1") firstrow clear      
{res}{text}(6 vars, 5,460 obs)

{com}. 
. gen quarter=.
{txt}(5,460 missing values generated)

{com}. replace quarter=3 if inrange(month, 1, 3)
{txt}(1,365 real changes made)

{com}. replace quarter=6 if inrange(month, 4,6)
{txt}(1,365 real changes made)

{com}. replace quarter=9 if inrange(month, 7,9)
{txt}(1,365 real changes made)

{com}. replace quarter=12 if inrange(month, 10, 12)
{txt}(1,365 real changes made)

{com}. 
. collapse (mean) ntl_radiance, by(prov year quarter)
{res}{txt}
{com}. 
. merge 1:1 prov year quarter using `pdrb' //Merging NTL with GDRP
{res}
{txt}{col 5}Result{col 33}Number of obs
{col 5}{hline 41}
{col 5}Not matched{col 30}{res}             408
{txt}{col 9}from master{col 30}{res}               0{txt}  (_merge==1)
{col 9}from using{col 30}{res}             408{txt}  (_merge==2)

{col 5}Matched{col 30}{res}           1,768{txt}  (_merge==3)
{col 5}{hline 41}

{com}. 
. *----- Additional Vars -----*
. g               q1=0
{txt}
{com}. replace q1=1 if quarter==3 
{txt}(544 real changes made)

{com}. 
. gen             q2=0
{txt}
{com}. replace q2=1 if quarter==6
{txt}(544 real changes made)

{com}. 
. gen     q3=0
{txt}
{com}. replace q3=1 if quarter==9 //Quarter dummy
{txt}(544 real changes made)

{com}. 
. g               covid=0
{txt}
{com}. replace covid=1 if inrange(year, 2020, 2022) //Covid dummy
{txt}(408 real changes made)

{com}. 
. gen covid_cont = 0
{txt}
{com}. replace covid_cont = year - 2019 if inrange(year, 2020, 2022)
{txt}(408 real changes made)

{com}. 
. g               scarring=0
{txt}
{com}. replace scarring=1 if inrange(year, 2020, 2025) //Scarring dummy
{txt}(816 real changes made)

{com}. 
. gen scar_cont = 0
{txt}
{com}. replace scar_cont = year - 2019 if inrange(year, 2020, 2025)
{txt}(816 real changes made)

{com}. 
. g               ln_ntl = ln(ntl_radiance)
{txt}(408 missing values generated)

{com}. g               ln_pdrb = ln(pdrb) //ln variables
{txt}(68 missing values generated)

{com}. 
. gen pulau = .
{txt}(2,176 missing values generated)

{com}.     replace pulau = 1 if inrange(prov,11,21)
{txt}(640 real changes made)

{com}.     replace pulau = 2 if inrange(prov,31,36)
{txt}(384 real changes made)

{com}.     replace pulau = 3 if inrange(prov,51,53)
{txt}(192 real changes made)

{com}.     replace pulau = 4 if inrange(prov,61,65)
{txt}(320 real changes made)

{com}.     replace pulau = 5 if inrange(prov,71,76)
{txt}(384 real changes made)

{com}.     replace pulau = 6 if inrange(prov,81,82)
{txt}(128 real changes made)

{com}.     replace pulau = 7 if inrange(prov,91,97) //Island Variables
{txt}(128 real changes made)

{com}. 
.     label define pulau_lbl  1 "SUMATERA" 2 "JAWA" 3 "BALI & NUSA TENGGARA" ///
>                             4 "KALIMANTAN" 5 "SULAWESI" 6 "MALUKU" 7 "PAPUA"
{txt}
{com}.     label values pulau pulau_lbl
{txt}
{com}.         
